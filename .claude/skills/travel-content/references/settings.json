      "header_font": "nanum_junghaksaeng.ttf",
      "footer_font": "tmon_monsori.ttf",
      "header_size": 0.067,
      "footer_size": 0.083,
      "margin_left": 0.055,
      "header_bottom": 0.151,
      "footer_bottom": 0.037,
      "header_underline": true,
      "header_shadow": {
        "radius": 0.15,
        "offset": [
          2,
          2
        ],
        "alpha": 170
      },
      "footer_shadow": {
        "radius": 0.12,
        "offset": [
          3,
          3
        ],
        "alpha": 170
      },
      "color": [
        255,
        255,
        255
      ]
    }
  },
  "shorts": {
    "aspect_ratio": "9:16",
