    "tts_enabled": true,
    "voice": "Yuna",
    "rate": 200,
    "sentence_pause": 0.25,
    "scene_pad": 0.25,
    "end_hold": 0.8,
    "transition": 0.3,
    "zoom": 0.06,
    "motion_seconds": 1.2,
    "subtitles_enabled": true,
    "subtitle": {
      "font": "Pretendard-Bold.ttf",
      "size": 64,
